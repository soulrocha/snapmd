{
  "manifest_version": 3,
  "name": "SnapMD — Markdown da página",
  "short_name": "SnapMD",
  "version": "1.5.0",
  "description": "Capture structured Markdown from modern SPAs, dashboards, portals, active modals, and dynamic web apps with SVG connectors and form states.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SnapMD — Extrair para Markdown",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
